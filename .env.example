# ==========================================
# Core Application Settings
# ==========================================
PROJECT_NAME="Project Hares"
ENVIRONMENT="development"
DEBUG=false
LOG_LEVEL="INFO"
SECRET_KEY="replace-with-a-cryptographically-secure-random-key-min-32-chars"

# ==========================================
# Meta WhatsApp Business Cloud API Settings
# ==========================================
WHATSAPP_API_VERSION="v21.0"
WHATSAPP_PHONE_NUMBER_ID="100000000000000"
WHATSAPP_BUSINESS_ACCOUNT_ID="200000000000000"
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_VERIFY_TOKEN="custom-secure-verify-token-for-get-challenge"
WHATSAPP_APP_SECRET="0123456789abcdef0123456789abcdef"
WHATSAPP_API_BASE_URL="https://graph.facebook.com"
WHATSAPP_LOCAL_STORAGE_REGION="UAE"

# ==========================================
# Cryptographic Privacy (FR-4.1 & NFR-1.3)
# ==========================================
# Minimum 32 bytes (64 hex characters) secure salt
CITIZEN_HASH_SALT="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
RATE_LIMIT_QUERIES_PER_HOUR=5
RATE_LIMIT_WINDOW_SECONDS=3600
REDIS_EPHEMERAL_PAYLOAD_TTL_SECONDS=60

# ==========================================
# Database Configuration (PostgreSQL 16)
# ==========================================
POSTGRES_USER="hares_admin"
POSTGRES_PASSWORD="secure_postgres_password_here"
POSTGRES_DB="hares_threat_db"
POSTGRES_HOST="db"
POSTGRES_PORT=5432
DATABASE_URL="postgresql+asyncpg://hares_admin:secure_postgres_password_here@db:5432/hares_threat_db"
DATABASE_URL_SYNC="postgresql+psycopg2://hares_admin:secure_postgres_password_here@db:5432/hares_threat_db"

# ==========================================
# Cache & Task Broker Configuration (Redis 7)
# ==========================================
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_PASSWORD="secure_redis_password_here"
REDIS_DB=0
REDIS_URL="redis://:secure_redis_password_here@redis:6379/0"
CELERY_BROKER_URL="redis://:secure_redis_password_here@redis:6379/1"
CELERY_RESULT_BACKEND="redis://:secure_redis_password_here@redis:6379/2"

# ==========================================
# Sovereign AI & Model Security Settings
# ==========================================
SLM_API_BASE_URL="http://slm:8000/v1"
SLM_MODEL_NAME="llama-3.2-3b-instruct-awq"
SLM_API_KEY="hares_internal_slm_key_min16chars"
TRIAGE_WEB_RATE_LIMIT_PER_MINUTE=15

# ==========================================
# Municipal Threat Intelligence & Security
# ==========================================
ANALYST_API_KEY="replace_with_analyst_key_min32chars_in_prod"
SOC_ADMIN_SALT_HEX="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
SOC_ADMIN_PASSWORD_HASH="742d493d2b34741a57abfde398e5fc86ebf8b4c74a629b516ef3d6be223b31c8"
SOC_ADMIN_PASSWORD="replace_with_high_entropy_passkey_min32chars_in_prod"
ANALYST_RATE_LIMIT_PER_MINUTE=120
STIX_SIGNING_KEY_HEX=""

