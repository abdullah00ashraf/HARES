    {
      "title": "Webhook Ingress Latency (p99 vs 50ms SLA)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(hares_webhook_ingress_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p99 Ingress (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hares_webhook_ingress_latency_seconds_bucket[1m])) by (le)) * 1000",
          "legendFormat": "p95 Ingress (ms)"
        },
        {
          "expr": "50",
          "legendFormat": "SLA Ceiling (50ms)"
        }
      ]
    },
    {
      "title": "End-to-End Triage Latency by Modality (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(hares_triage_e2e_latency_seconds_bucket{payload_type=\"text\"}[1m])) by (le))",
          "legendFormat": "Text p95 (s)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(hares_triage_e2e_latency_seconds_bucket{payload_type=~\"audio|voice\"}[1m])) by (le))",
